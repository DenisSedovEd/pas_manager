# ─── База данных (PostgreSQL) ─────────────────────────────────────────────────
DB__HOST=127.0.0.1
DB__PORT=5432
DB__NAME=pas_manage
DB__USER=pas_user
DB__PASSWORD=change_me
DB__ECHO=False
DB__FUTURE=True


# ─── Приложение ───────────────────────────────────────────────────────────────
APP__HOST=0.0.0.0
APP__PORT=8000
APP__DEBUG=False

# Через сколько секунд удаляются сообщения бота
APP__DELETE_TIMEOUT_SECONDS=30

# Время жизни сессии в секундах (устаревшее — fallback для обоих клиентов)
# APP__SESSION_TTL=3600

# Отдельный TTL для веб-интерфейса
APP__SESSION_TTL_WEB=3600

# Отдельный TTL для Telegram mini app и бота
APP__SESSION_TTL_MINIAPP=86400

# Токен Cloudflare Tunnel (cloudflared tunnel token)
APP__TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Ваш Telegram user ID (для проверки доступа к веб-интерфейсу)
APP__ADMIN_ID=your_telegram_user_id

# Список разрешённых CORS-источников (JSON-массив)
APP__CORS_ORIGINS=["https://web.telegram.org","https://t.me"]

# Лимит попыток входа: сколько попыток разрешено за окно времени ниже
APP__RATE_LIMIT_MAX_ATTEMPTS=5

# Окно времени для лимита попыток входа, секунды
APP__RATE_LIMIT_WINDOW_SECONDS=60


# ─── Безопасность транспорта ──────────────────────────────────────────────────
# ВНИМАНИЕ: значения в этом файле подхватываются как значения по умолчанию
# (он включён в цепочку env_file). Настройки «на автомате» оставлены
# закомментированными — если их раскомментировать, автоопределение отключится.

# Флаг Secure у cookie сессии.
# По умолчанию (закомментировано) определяется по схеме запроса: через туннель
# по https cookie помечается Secure, доступ из локальной сети по http
# продолжает работать. Раскомментируйте только чтобы задать жёстко.
# APP__COOKIE_SECURE=True

# Каким узлам доверять X-Forwarded-For / X-Forwarded-Proto.
# По умолчанию — значение uvicorn (127.0.0.1). Если приложение стоит за
# cloudflared или реверс-прокси, без этой настройки лимит попыток входа видит
# один IP прокси вместо реальных клиентов, а схема запроса определяется как
# http (значит cookie не получит Secure). Укажите адрес прокси, либо "*",
# если до приложения доходит только трафик прокси.
# APP__FORWARDED_ALLOW_IPS=172.18.0.0/16

# Strict-Transport-Security: max-age в секундах, 0 — не отправлять.
# Уходит только на https-ответах. Включайте осознанно: заголовок запрещает
# браузеру обращаться к этому хосту по http. На хост, к которому вы ходите
# по http из локальной сети, он не отправляется.
APP__HSTS_SECONDS=0

# Отдавать /docs, /redoc и /openapi.json.
# По умолчанию (закомментировано) — следует APP__DEBUG, то есть в проде
# выключено: это полная карта API, и авторизация её не закрывает.
# APP__EXPOSE_DOCS=False

# Максимальный возраст auth_date в initData Telegram, секунды; 0 — не проверять.
# Подпись Telegram сама не истекает, поэтому без этой проверки однажды
# перехваченная строка initData остаётся действительным пропуском бессрочно.
APP__INIT_DATA_MAX_AGE_SECONDS=86400

# Жёсткий предел жизни сессии от момента входа, секунды; 0 — без предела.
# Обычный TTL выше продлевается на каждом запросе, поэтому активная сессия
# живёт неограниченно долго, а мастер-пароль всё это время в памяти процесса.
# Рекомендуется выставить (например, 43200 для веба), но учтите: по истечении
# предела потребуется повторный ввод мастер-пароля.
APP__SESSION_ABSOLUTE_TTL_WEB=0
APP__SESSION_ABSOLUTE_TTL_MINIAPP=0


# ─── Telegram ─────────────────────────────────────────────────────────────────

# Ваш Telegram user ID (только этот пользователь имеет доступ к боту)
TG__USER_ID=your_telegram_user_id

# Токен бота от @BotFather
TG__TELEGRAM_TOKEN=your_bot_token_here


# ─── Шифрование ───────────────────────────────────────────────────────────────

# Длина ключа AES в байтах (рекомендуется 32 = AES-256)
CRYPTO__KEY_LENGTH=32

# Размер соли в байтах (рекомендуется 32)
CRYPTO__SALT_SIZE=32

# Количество итераций PBKDF2 (чем больше — тем безопаснее, но медленнее)
CRYPTO__ITERATIONS=480000
